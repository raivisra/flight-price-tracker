# Travelpayouts API Token
# Get from: https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=your_token_here_e9c0581758af551d3fe17cb4e1085a00

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=travelai
DB_PASSWORD=travelai_dev_pwd
DB_NAME=travelai_db

# Backend
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Ollama (Local LLM)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# Optional: JWT Secret (for auth later)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Set to 0 ONLY on a dev machine behind a TLS-intercepting corporate proxy.
# Disables certificate verification for all outbound HTTPS. Never in production.
NODE_TLS_REJECT_UNAUTHORIZED=1

# SerpApi Google Flights (free tier: 250 searches/month)
# Get from https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here
